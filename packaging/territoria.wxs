<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows installer of Territoria (WiX 4 or newer); built by build-msi.ps1. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- The UpgradeCode stays the same forever: newer versions replace older ones. -->
  <Package Name="Territoria"
           Manufacturer="ortic"
           Version="$(var.Version)"
           UpgradeCode="FDA16516-0237-435A-A23B-9A44FF7F9AF6"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Territoria – geomarketing and territory planning" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Territoria is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="territoria.ico" SourceFile="$(var.Packaging)\territoria.ico" />
    <Property Id="ARPPRODUCTICON" Value="territoria.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ortic/territoria" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Territoria">
        <Component Id="Program" Bitness="always64">
          <File Id="territoria.exe" Source="$(var.Target)\territoria.exe" KeyPath="yes">
            <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="Territoria"
                      Description="Geomarketing and territory planning"
                      WorkingDirectory="INSTALLFOLDER" Icon="territoria.ico" Advertise="yes" />
          </File>
          <!-- The documents' icon: a file of the installation. -->
          <File Id="DocumentIcon" Source="$(var.Packaging)\territoria.ico" />
          <!-- .territoria files open in Territoria. -->
          <ProgId Id="Territoria.Project" Description="Territoria project" Icon="DocumentIcon" IconIndex="0">
            <Extension Id="territoria" ContentType="application/x-territoria">
              <Verb Id="open" Command="Open" TargetFile="territoria.exe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        </Component>
        <!-- A file each: unversioned files get their own component. -->
        <Component Id="Guide" Bitness="always64">
          <File Id="Guide" Source="$(var.Root)\docs\guide.md" Name="Guide.md" KeyPath="yes" />
        </Component>
        <Component Id="Readme" Bitness="always64">
          <File Id="Readme" Source="$(var.Root)\README.md" Name="README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <!-- Where the Start menu entry goes. -->
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Territoria">
      <ComponentRef Id="Program" />
      <ComponentRef Id="Guide" />
      <ComponentRef Id="Readme" />
    </Feature>
  </Package>
</Wix>
